# No build step, so nothing here is bundled. These are the names of the
# Supabase Edge Function secrets (set with `supabase secrets set`), listed
# so every session uses the same names. Never commit real values.
#
# The page itself only uses the publishable key in js/config.js (public by design).
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided to Edge Functions automatically.

# Stripe (read-only restricted key: Customers read, Subscriptions read)
IES_STRIPE_RESTRICTED_KEY=
IES_STRIPE_WEBHOOK_SECRET=
IES_STRIPE_ACCOUNT=            # only if the account sits under a Connect platform, e.g. acct_1Sz098PlBE5vm85Q

# GoHighLevel (Private Integration token, contacts.readonly)
IES_GHL_PRIVATE_TOKEN=
IES_GHL_LOCATION_ID=06KFUoalbbFOPinVxNeY

# Discord (bot with the Server Members intent, no other permissions needed)
IES_DISCORD_BOT_TOKEN=
IES_DISCORD_GUILD_ID=

# Shared secret the scheduled jobs send; same value goes in Vault as ies_cron_secret
IES_CRON_SECRET=
